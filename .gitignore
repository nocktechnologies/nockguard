# Root-anchored so it ignores the built `nockguard` binary at the repo root
# without also swallowing the cmd/nockguard/ source directory (the bare pattern
# `nockguard` matched that dir, silently ignoring new source files under it).
/nockguard
/bin/
/dist/
/nockguard.new
/nockguard-wall
/cmd/nockguard-wall/nockguard-wall
/nockguard.bak-*
/.githooks/
cmd/nockguard-wall/testdata/*.db-shm
cmd/nockguard-wall/testdata/*.db-wal
